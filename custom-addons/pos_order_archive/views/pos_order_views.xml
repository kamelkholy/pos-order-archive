<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit POS Order List View: add active field -->
    <record id="view_pos_order_list_inherit_archive" model="ir.ui.view">
        <field name="name">pos.order.list.inherit.archive</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-muted">not active</attribute>
            </xpath>
            <field name="state" position="after">
                <field name="active" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Inherit POS Order Form View: add archive button and active field -->
    <record id="view_pos_order_form_inherit_archive" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.archive</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="active" invisible="1"/>
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit POS Order Search View: add archive filter -->
    <record id="view_pos_order_search_inherit_archive" model="ir.ui.view">
        <field name="name">pos.order.search.inherit.archive</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
